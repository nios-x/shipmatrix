{
  "expo": {
    "name": "ShipMatrix",
    "slug": "shipmatrix",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.otf",
            "./assets/fonts/Geist-Medium.otf",
            "./assets/fonts/Geist-SemiBold.otf",
            "./assets/fonts/Geist-Bold.otf",
            "./assets/fonts/Geist-Black.otf",
            "./assets/fonts/Geist-Light.otf",
            "./assets/fonts/Geist-Thin.otf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "ShipMatrix uses the camera to measure your parcel. Photos stay on your phone.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-monochrome.png",
          "color": "#7C3AED"
        }
      ],
      "@sentry/react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "extraProguardRules": "-keep class com.cashfree.** { *; }\n-dontwarn com.cashfree.**\n-dontwarn com.google.mlkit.**"
          }
        }
      ]
    ],
    "scheme": [
      "shipmatrix",
      "com.shipmatrix.app"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shipmatrix.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#4C1D95"
      },
      "package": "com.shipmatrix.app",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "93adbb1f-03ba-4046-8a8d-0e20a35f22a8"
      }
    }
  }
}
