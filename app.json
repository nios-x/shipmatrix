{
  "expo": {
    "name": "ShipMatrix",
    "slug": "shipmatrix",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.otf",
            "./assets/fonts/Geist-Medium.otf",
            "./assets/fonts/Geist-SemiBold.otf",
            "./assets/fonts/Geist-Bold.otf",
            "./assets/fonts/Geist-Black.otf",
            "./assets/fonts/Geist-Light.otf",
            "./assets/fonts/Geist-Thin.otf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "scheme": [
      "shipmatrix",
      "com.shipmatrix.app"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shipmatrix.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#4C1D95"
      },
      "package": "com.shipmatrix.app"
    }
  }
}
