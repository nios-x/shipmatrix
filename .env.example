# Origin of the ShipMatrix payments server (the `shipmatrix-server` project).
# Leave unset to use the deployed host baked into src/lib/api.ts.
# To hit a server on your own machine instead, use your LAN IP — not localhost,
# which on a phone points at the phone itself. A plain-http URL only works in a
# debug build; release builds block cleartext traffic on Android.
# EXPO_PUBLIC_PAYMENTS_URL=http://192.168.1.5:3000

# Google Sign-In. OAuth client ids are public values, so they belong here rather
# than in source. Leave a platform's id unset and the app hides its "Continue
# with Google" button on that platform instead of shipping a button that fails.
#
# Create these at Google Cloud Console > gen-lang-client-0372703048 (project
# number 563260211850, the Firebase project in src/lib/firebase-config.ts) >
# APIs & Services > Credentials. Firebase rejects ID tokens minted for another
# project's client, so they must live in that project. The Google provider must
# also be enabled in Firebase Auth.
#
#   Android — application type "Android", "Custom URI scheme" enabled under
#             Advanced Settings
#             package name  com.shipmatrix.app
#             SHA-1         42:26:B3:8A:5B:55:7D:CC:90:03:5B:EA:D1:EA:F9:58:B8:A6:70:0B
#                           (the EAS-managed release keystore), or
#                           5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
#                           (android/app/debug.keystore)
#             This browser-redirect flow can't prove which key signed the app,
#             so Google checks only the package name: one client id works for
#             debug and release builds alike.
#   iOS     — application type "iOS", bundle id com.shipmatrix.app
#
# .env is gitignored, so EAS cloud builds never see this file. Set the same
# values there too: eas env:create --name <NAME> --value <id> ...
#
# Native sign-in needs a development build. It cannot work in Expo Go, which owns
# the exp:// scheme and so swallows the OAuth redirect.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional; defaults to the web client Firebase Auth created for this project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Crash reporting (Sentry). Create a project at sentry.io and paste its DSN
# here. Left unset, Sentry.init is skipped entirely — see App.tsx — so crashes
# go unreported rather than half-configured.
EXPO_PUBLIC_SENTRY_DSN=
 